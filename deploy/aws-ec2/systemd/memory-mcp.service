[Unit]
Description=Memory MCP (Uvicorn ASGI)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mcp-starter
EnvironmentFile=/etc/mcp-starter/env
Environment=PATH=/opt/mcp-starter/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/mcp-starter/.venv/bin/uvicorn memory_mcp.server:app --host 127.0.0.1 --port 8007
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
