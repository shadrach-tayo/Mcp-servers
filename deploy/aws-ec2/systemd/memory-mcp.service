[Unit]
Description=Memory MCP (Uvicorn ASGI, no nginx on host)
After=network.target

[Service]
Type=simple
# Amazon Linux: ec2-user. Ubuntu: www-data.
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/mcp-servers
EnvironmentFile=/etc/mcp-servers/env
Environment=PATH=/opt/mcp-servers/.venv/bin:/usr/local/bin:/usr/bin
Environment=PYTHONPATH=/opt/mcp-servers/src
# python -m avoids 203/EXEC when the uvicorn wrapper shebang is wrong or missing
ExecStart=/opt/mcp-servers/.venv/bin/python -m uvicorn memory_mcp.server:app --host 0.0.0.0 --port 8007
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
