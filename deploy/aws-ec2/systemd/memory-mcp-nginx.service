[Unit]
Description=Memory MCP (Uvicorn behind nginx)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mcp-servers
EnvironmentFile=/etc/mcp-servers/env
Environment=PATH=/opt/mcp-servers/.venv/bin:/usr/local/bin:/usr/bin
# Only localhost — nginx on :443 is the public entrypoint
ExecStart=/opt/mcp-servers/.venv/bin/uvicorn memory_mcp.server:app --host 127.0.0.1 --port 8007
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
