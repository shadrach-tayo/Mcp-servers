# Copy to /etc/mcp-servers/env on EC2 (chmod 600). Do not commit real values.

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
JWT_SIGNING_KEY=
STORAGE_ENCRYPTION_KEY=
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# Public URL clients use (HTTPS if behind ALB + ACM; HTTP only for local practice)
BASE_URL=https://memory-mcp.example.com

# Path prefix for MCP app (health: GET {prefix}/health, e.g. /api/health)
MCP_MOUNT_PREFIX=/api
# MCP_PATH=
