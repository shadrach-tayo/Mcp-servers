# Copy to .env for local dev only. Production: inject these via your platform
# (K8s Secret, ECS task env, Fly/Railway secrets, docker run -e, etc.).
#
# Local run:
#   uv run --env-file .env memory-mcp
#
# Docker:
#   docker run --env-file .env -p 8007:8007 mcp-starter:memory

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Public URL of this MCP server (OAuth redirects). Required in prod behind HTTPS.
# MCP_BASE_URL=https://memory-mcp.example.com
